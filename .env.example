# ============ Life OS 环境变量模板 ============
# 复制为 .env 后填写。所有密钥缺失时服务不会崩溃，只降级。

PORT=3000

# 写保护口令：访客可自由浏览，增删改需站主令牌（专属链接 /?auth=口令 一次解锁，10 年有效）
ACCESS_CODE=

TMDB_API_KEY=
STEAM_API_KEY=
STEAM_ID=
GITHUB_TOKEN=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
WEATHER_CITY=Shenzhen

# 海外服务器直连外网，留空即可；大陆本机开发填本地代理
HTTPS_PROXY=
